{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Ws.Api", "--launch-profile", "http"],
      "port": 5154
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "web"],
      "port": 5173
    },
    {
      "name": "playground",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8099", "--directory", "design/playground"],
      "port": 8099
    },
    {
      "name": "motion",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8098", "--directory", "design/motion"],
      "port": 8098
    }
  ]
}
