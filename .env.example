# Copy to .env (gitignored) for Docker. Locally `dotnet run` uses `dotnet user-secrets` instead;
# scripts/env-from-user-secrets.ps1 copies those into .env for you.
Claude__ApiKey=
Telegram__BotToken=
Telegram__StaffChatId=
# First owner account for /admin (password min 10 chars). Only used while the DB has no staff users.
Admin__Login=
Admin__Password=
# Only for `docker compose --profile named-tunnel` (Cloudflare tunnel on your own domain).
# Keep it in user-secrets too (dotnet user-secrets set TUNNEL_TOKEN <token> --project src/Ws.Api) so the .env script carries it over.
TUNNEL_TOKEN=
